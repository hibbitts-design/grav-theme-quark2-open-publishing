{# A blog post's content: Quark 2's post, plus what Quark Open Publishing adds - reading time, /hidepagetitle:true,
   the blog's Display Post Summary setting (off hides the summary at the top of the full post), /summaryonly:true (just the
   summary, with a Continue Reading link that opens the full post), and no Previous/Next Post in embedded mode - hibbittsdesign.org #}
{# true unless the page is embedded or the whole site is chromeless #}
{% set site_chrome = not embedded_mode and not theme_var('chromeless.enabled') %}
{% set summary_only = grav.uri.param('summaryonly') or grav.uri.param('onlysummary') %}
<article class="content-item h-entry">

{% if not hero_image_name %}
    <header class="content-title text-center">
        {# embedded (for example in an LMS), the title is plain text rather than a link to this same page;
           a link post keeps its title link, which goes to the article it shares #}
        {% if site_chrome or page.header.link %}
            {% include 'partials/blog/title.html.twig' with {title_level: 'h1'} %}
        {% elseif not grav.uri.param('hidepagetitle') %}
            <h1 class="p-name mt-1">{{ page.title }}</h1>
        {% endif %}
        {% if not grav.uri.param('hidepagetitle') %}
            {% if page.header.subtitle %}
                <p class="lead">{{ page.header.subtitle }}</p>
            {% endif %}
            {% include 'partials/blog/date.html.twig' %}
            {% if config.plugins.readingtime.enabled %}
                <span class="blogitem__readingtime">{% include 'partials/blog/readingtime.html.twig' %}</span>
            {% endif %}
            {# the tags link to the blog's lists, which is site navigation, so they're left out when embedded #}
            {% if site_chrome %}
                {% include 'partials/blog/taxonomy.html.twig' %}
            {% endif %}
        {% endif %}
    </header>
{% endif %}

    <div class="e-content">
        {% if page.parent.header.display_post_summary.enabled %}
            {% set content = page.content|slice(page.summary|length) %}
        {% else %}
            {% set content = page.content %}
        {% endif %}

        {% if not summary_only %}
            {{ (content is not empty ? content : page.summary)|raw }}
        {% else %}
            {{ page.summary|raw }}
            {% if page.header.continue_link is same as(true) %}
                <p><a href="{{ page.url ~ '/chromeless:true' }}" title="{{ page.title }}" class="btn btn-primary topwindow external-link">{{ 'THEME_QUARK.BLOG.ITEM.CONTINUE_READING'|t }}</a></p>
            {% endif %}
        {% endif %}
    </div>

    {% if config.plugins.comments.enabled %}
        {% include 'partials/comments.html.twig' ignore missing %}
    {% endif %}
</article>

{% if not embedded_mode and not theme_var('chromeless.enabled') and not summary_only %}
<nav class="prev-next" aria-label="{{ 'THEME_QUARK2.ARIA.POST_NAVIGATION'|t|e('html_attr') }}">
    {% if not page.isLast %}
        <a class="btn btn-ghost" href="{{ page.prevSibling.url }}"><i class="fa-solid fa-angle-left" aria-hidden="true"></i> {{ 'THEME_QUARK2.BLOG.ITEM.PREV_POST'|t }}</a>
    {% else %}<span></span>{% endif %}

    {% if not page.isFirst %}
        <a class="btn btn-ghost" href="{{ page.nextSibling.url }}">{{ 'THEME_QUARK2.BLOG.ITEM.NEXT_POST'|t }} <i class="fa-solid fa-angle-right" aria-hidden="true"></i></a>
    {% else %}<span></span>{% endif %}
</nav>
{% endif %}

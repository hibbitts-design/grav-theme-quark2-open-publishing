{# Sidebar for blog and course pages: Quark 2's sidebar plus a "sidebar" page and search. In a course:
   the course's own sidebar page and course search, no blog-only blocks - hibbittsdesign.org #}
{% set new_base_url = blog and blog.url != '/' ? blog.url : '' %}
{% set is_blog_page = page.template in ['blog', 'item'] %}
{# (in a course, only its own "sidebar" page) #}
{% set sidebar_page = course_page ? page.find(course_page.route ~ '/sidebar') : pages.find('/sidebar') %}
{% set sidebar_page_content = sidebar_page.content %}
{% set sidebar_position = sidebar_page.header.position ?: 'top' %}

{% if config.plugins.tntsearch.enabled or config.plugins.simplesearch.enabled %}
<div class="sidebar-content">
    {# (in a course, search just the course) #}
    {% set sidebar_search_scope = search_scope ?? null %}
    {% if course_page %}
        {% set sidebar_search_scope = course_page %}
    {% endif %}
    {% include 'partials/search_box.html.twig' with { search_scope: sidebar_search_scope } %}
</div>
{% endif %}

{% if sidebar_position == 'top' and sidebar_page_content is not empty %}
<div class="sidebar-content sidebar-page">
    {{ sidebar_page_content|raw }}
</div>
{% endif %}

{% if is_blog_page and config.plugins.relatedpages.enabled and related_pages|length > 0 %}
<div class="sidebar-content">
    <h4>{{ 'THEME_QUARK2.SIDEBAR.RELATED_POSTS.HEADLINE'|t }}</h4>
    {% include 'partials/relatedpages.html.twig' %}
</div>
{% endif %}

{% if is_blog_page and config.plugins.random.enabled %}
<div class="sidebar-content">
    <h4>{{ 'THEME_QUARK2.SIDEBAR.RANDOM_ARTICLE.HEADLINE'|t }}</h4>
    <a class="btn btn-ghost btn-sm" href="{{ base_url }}/random"><i class="fa-solid fa-shuffle" aria-hidden="true"></i> {{ 'THEME_QUARK2.SIDEBAR.RANDOM_ARTICLE.FEELING_LUCKY'|t }}</a>
</div>
{% endif %}

{# Quark 2's sidebar text, from a /modules/sidebar page (as in Grav's blog skeleton) #}
{% if is_blog_page %}{{ page.find('/modules/sidebar').content|raw }}{% endif %}

{# (Popular Tags and Archives are left out when the blog hides its post tags or dates, as Weekly Units does) #}
{% if is_blog_page and config.plugins.taxonomylist.enabled and not blog.header.hide_post_taxonomy %}
<div class="sidebar-content">
    <h4>{{ 'THEME_QUARK2.SIDEBAR.POPULAR_TAGS.HEADLINE'|t }}</h4>
    {% include 'partials/taxonomylist.html.twig' with {'base_url': new_base_url, 'taxonomy': 'tag', 'children_only': true, 'of_page': blog} %}
</div>
{% endif %}

{% if is_blog_page and config.plugins.archives.enabled and not blog.header.hide_post_date %}
<div class="sidebar-content">
    <h4>{{ 'THEME_QUARK2.SIDEBAR.ARCHIVES.HEADLINE'|t }}</h4>
    {% include 'partials/archives.html.twig' with {'base_url': new_base_url} %}
</div>
{% endif %}

{% if sidebar_position == 'bottom' and sidebar_page_content is not empty %}
<div class="sidebar-content sidebar-page">
    {{ sidebar_page_content|raw }}
</div>
{% endif %}

{% if is_blog_page and config.plugins.feed.enabled %}
<div class="sidebar-content syndicate">
    <h4>{{ 'THEME_QUARK2.SIDEBAR.SYNDICATE.HEADLINE'|t }}</h4>
    <a class="btn btn-ghost btn-sm" href="{{ blog.url(false, false, true, false, 'atom')|e }}"><i class="fa-solid fa-square-rss" aria-hidden="true"></i> Atom</a>
    <a class="btn btn-ghost btn-sm" href="{{ blog.url(false, false, true, false, 'rss')|e }}"><i class="fa-solid fa-square-rss" aria-hidden="true"></i> RSS</a>
</div>
{% endif %}

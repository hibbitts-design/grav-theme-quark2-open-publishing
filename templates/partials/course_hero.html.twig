{# The course's header image as a banner on its home page only - just the image, as in Open Matter: the course's name
   is in the course navbar, above it or (Course Navbar Below Header Image setting) below it. The banner itself is worked
   out in partials/base.html.twig - hibbittsdesign.org #}
{% if course_banner %}
    {# alt="" as the image is decoration (screen readers skip it) #}
    <div class="course-banner">
        <img src="{{ course_banner.url }}" alt="">
    </div>
    {% if course_navbar_below_banner %}
        {% include 'partials/course_navbar.html.twig' %}
    {% endif %}
{% endif %}

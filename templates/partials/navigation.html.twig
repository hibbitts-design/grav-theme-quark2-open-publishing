{# Site menu: Quark 2's menu, plus what Quark Open Publishing adds - the Display Dropdowns in Menu setting, custom menu items,
   the Git Sync link (when its location is the menu), and page icons set with either "icon" (Quark Open Publishing)
   or "menu_icon" (Quark 2). A page with hide_from_menu: true is left out of the menu but stays visible, so (unlike
   visible: false) a guide can still have its card on a Guides List page, as in Grav Helios Open Reader - hibbittsdesign.org #}
{% macro nav_loop(page) %}
  {% import _self as macros %}
  {% for p in page.children.visible %}
    {% if not p.header.hide_from_menu %}
    {% set active_page = (p.active or p.activeChild) ? 'active' : '' %}
    {# the highlight also marks the section the current page is in; aria-current tells screen readers which item is the current page itself #}
    {% set has_children = theme_var('dropdown.enabled') and p.children.visible.count > 0 %}
    {% set page_icon = p.header.menu_icon ?: p.header.icon %}
    <li{% if has_children %} class="has-children"{% endif %}>
      <a href="{{ p.url }}" class="{{ active_page }}"{% if p.active %} aria-current="page"{% endif %}>
        {% if page_icon %}<i class="{{ page_icon|fa_icon }}" aria-hidden="true"></i>{% endif %}
        {{ p.menu }}
      </a>
      {% if has_children %}
      <ul>
        {{ macros.nav_loop(p) }}
      </ul>
      {% endif %}
    </li>
    {% endif %}
  {% endfor %}
{% endmacro %}
{% import _self as macros %}

{# The guide this page belongs to: the nearest Section List page, from this page up #}
{% set guide_home = null %}
{% set ancestor = page %}
{% for level in 1..5 %}
    {% if ancestor and not guide_home %}
        {% if ancestor.template == 'section-list' %}
            {% set guide_home = ancestor %}
        {% else %}
            {% set ancestor = ancestor.parent %}
        {% endif %}
    {% endif %}
{% endfor %}
{# The guide's own extra pages, such as Topics or Resources: the pages in its folder without a number prefix (which
   keeps them out of its sections), ordered by their menu_order setting and then by folder name. Hide from Menu leaves
   one out. The folder name is checked too, so a numbered section with Visible turned off isn't added. ksort sorts
   them by the "order-folder" key, such as "001-topics" #}
{% set guide_menu_pages = {} %}
{% if guide_home %}
    {% for p in guide_home.children %}
        {% set numbered = p.folder matches '/^[0-9]+[.]/' %}
        {% if not numbered and not p.visible and p.published and p.routable and not p.header.hide_from_menu %}
            {% set sort_key = '%03d-%s'|format(p.header.menu_order ?? 999, p.slug) %}
            {% set guide_menu_pages = guide_menu_pages|merge({(sort_key): p}) %}
        {% endif %}
    {% endfor %}
    {% set guide_menu_pages = guide_menu_pages|ksort %}
{% endif %}

{# how many of the site's top-level pages are in the menu, so the divider below only shows when there are some #}
{% set site_menu_count = 0 %}
{% for p in pages.children.visible %}
    {% if not p.header.hide_from_menu %}
        {% set site_menu_count = site_menu_count + 1 %}
    {% endif %}
{% endfor %}

<ul {{ tree ? 'class="tree navigation"' : 'class="navigation"' }}>
    {{ macros.nav_loop(pages) }}
    {% if guide_menu_pages|length > 0 and site_menu_count > 0 %}
        {# a thin line between the site's own menu items and the guide's (hidden from screen readers, which don't need it) #}
        <li class="guide-menu-divider" aria-hidden="true"></li>
    {% endif %}
    {# while reading a guide, its own extra pages (aria-current tells screen readers which one is open) #}
    {% for p in guide_menu_pages %}
        {% set page_icon = p.header.menu_icon ?: p.header.icon %}
        <li>
            <a href="{{ p.url }}" class="{{ p.active ? 'active' : '' }}"{% if p.active %} aria-current="page"{% endif %}>
                {% if page_icon %}<i class="{{ page_icon|fa_icon }}" aria-hidden="true"></i>{% endif %}
                {{ p.menu }}
            </a>
        </li>
    {% endfor %}
    {# custom menu items #}
    {% if theme_var('displaycustommenus.enabled') %}
        {% for mitem in theme_var('menu') %}
            <li>
                <a href="{{ mitem.url }}" target="{{ mitem.target }}">
                    {% if mitem.icon %}<i class="{{ mitem.icon|fa_icon }}" aria-hidden="true"></i>{% endif %}
                    {{ mitem.text }}
                </a>
            </li>
        {% endfor %}
    {% endif %}
    {# the Git Sync link, when its location is the menu (the default) #}
    {% if theme_var('display_of_git_sync_repo_link') == 'menu' or theme_var('display_of_git_sync_repo_link') is empty %}
        {# include() gets the link first, so the menu item is only added when there is one #}
        {% set git_sync_link = include('partials/git_sync_repo_link.html.twig') %}
        {% if git_sync_link|trim %}
            <li>{{ git_sync_link|raw }}</li>
        {% endif %}
    {% endif %}
    {# the "This page as Markdown" link, when its location is the menu (Page when none has been saved yet) #}
    {% set markdown_link_location = theme_var('markdown_link.location') %}
    {% if markdown_link_location == 'menu' %}
        {% set markdown_link = include('partials/markdown_link.html.twig') %}
        {% if markdown_link|trim %}
            <li>{{ markdown_link|raw }}</li>
        {% endif %}
    {% endif %}
</ul>

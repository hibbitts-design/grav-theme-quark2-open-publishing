{# Section List page: a reader home with its details and Start Reading button, and a card for each section (as in Helios Open Reader).
   Its sections and subsections use the same templates as the Multi-Section page - hibbittsdesign.org #}
{% extends 'partials/base.html.twig' %}

{# Cover Image Layout "hero": the cover across the full width behind the guide's title and subtitle, using Quark 2's own
   hero (its overlay, light text and arrow down to the content; Quark 2's hero_classes and hero_align settings also
   work). Not on embedded pages, which show only the content, with the title as usual - hibbittsdesign.org #}
{# A guide's home page, or a course's Modules page (module.html.twig sets list_mode to 'modules': module cards,
   without a guide's cover, details, Start button or section labels) #}
{% set list_mode = list_mode ?? 'guide' %}

{% block hero %}
  {% set hero_cover = page.header.cover_image ? page.media[page.header.cover_image] : null %}
  {% if list_mode == 'guide' and hero_cover and page.header.cover_image_layout == 'hero' and show_site_chrome %}
    {% set hero_text %}
      <h1>{{ page.title }}</h1>
      {% if page.header.subtitle %}<p class="lead">{{ page.header.subtitle }}</p>{% endif %}
    {% endset %}
    {% include 'partials/hero.html.twig' with { id: 'guide-hero', hero_image: hero_cover, content: hero_text } %}
  {% endif %}
{% endblock %}

{% block content %}
  {% import 'macros/reader.html.twig' as reader %}

  {% set reader_home = page %}
  {# The guide's sections: the page collection when it lists its items, or otherwise (such as a publication
     copied from Grav Helios Open Reader) the child pages, in the Order By and Order settings' order when set.
     (Saving in the Admin can add the order settings without the items, so the items are what's checked.) #}
  {% if page.header.content.items is defined %}
    {% set reader_sections = page.collection.visible() %}
  {% else %}
    {% set reader_sections = page.children.visible() %}
    {% if page.header.content.order.by is defined %}
      {% set reader_sections = reader_sections.order(page.header.content.order.by, page.header.content.order.dir|default('asc')) %}
    {% endif %}
  {% endif %}

  {# Keep a tag filter (/filter:...) on the card and Start Reading links, as the side navigation does #}
  {% set activetag = uri.param('filter') %}
  {% set filter_suffix = activetag ? '/filter:' ~ activetag : '' %}

  {# Cover Image Layout: by default a small cover is shown with the title, subtitle, author(s), edition and license
     beside it; "large" shows it across the full width of the content area at the top, with the title below it #}
  {% set modules_mode = list_mode == 'modules' %}
  {% set cover = (page.header.cover_image and not modules_mode) ? page.media[page.header.cover_image] : null %}
  {% set large_cover = cover and page.header.cover_image_layout == 'large' %}
  {# "hero": the title and subtitle are in the hero above (see the hero block), so they and the cover are left out here #}
  {% set hero_cover = cover and page.header.cover_image_layout == 'hero' and show_site_chrome %}
  {% set show_title = not(page.header.hide_page_title) and not(grav.uri.param('hidepagetitle')) and not hero_cover %}
  {# with a small cover, the title goes beside it, at the top of the details, like a publication card #}
  {% set title_beside_cover = cover and not large_cover and not hero_cover %}

  {# (the page is saved as text first, so it can go beside the course sidebar on a Modules page - see the end) #}
  {% set section_list_html %}
  <div class="section-list-page">

    {% if large_cover %}
      {# a portrait cover, such as a book cover, is shown whole at its own width, instead of trimmed to the full width #}
      {% set cover_class = 'reader-cover-large' %}
      {% if cover.get('height') > cover.get('width') %}
        {% set cover_class = cover_class ~ ' reader-cover-large-portrait' %}
      {% endif %}
      {# the Cover Image Alt Text setting describes the picture for screen readers; without it, "<title> cover" #}
      {% set cover_alt = page.header.cover_image_alt ?: 'THEME_QUARK_OPEN_PUBLISHING.READER_COVER'|t(page.title) %}
      <img class="{{ cover_class }}" src="{{ cover.url }}" alt="{{ cover_alt }}">
    {% endif %}

    {% if show_title and not title_beside_cover %}
      <h1 class="sections-page-title-template h3">{{ page.title }}</h1>
    {% endif %}

    {# Start button, linking to the first section, at the end of the details (an empty start_button_text hides it) #}
    {% if page.header.start_button_text is defined %}
      {% set start_text = page.header.start_button_text %}
    {% else %}
      {% set start_text = 'THEME_QUARK_OPEN_PUBLISHING.READER_START'|t %}
    {% endif %}
    {% set first_section = reader_sections|first %}
    {% set start_url = (start_text and first_section and not modules_mode) ? first_section.url ~ filter_suffix : '' %}

    {% if modules_mode %}
      {# a Modules page: its description as an intro (a Helios Modules page often has only that), and its Learning
         Objectives, as on guide pages #}
      {% if page.header.description %}
        <p class="reader-subtitle module-intro">{{ page.header.description }}</p>
      {% endif %}
      {% if page.header.learning_objectives %}
        {{ ('[objectives]' ~ page.header.learning_objectives|markdown ~ '[/objectives]')|shortcodes|raw }}
      {% endif %}
    {% else %}
    {% include 'partials/reader_header.html.twig' with { hide_cover: large_cover or hero_cover, hide_subtitle: hero_cover, show_title: show_title and title_beside_cover, start_text: start_text, start_url: start_url } %}
    {% endif %}

    {# Text above and below the section cards, as in Helios Open Reader: a line with just === in the page's content
       splits it, with the text before it above the cards and the text after it below them (=== is Grav's summary
       delimiter, so the text above is the page's summary). Without ===, all of the text is above the cards. #}
    {# (only when the summary really is the start of the text: === can also appear for other reasons, such as a
       heading underlined with ===, and then the summary is a shortened copy and all of the text stays above) #}
    {% set content_above = page.content %}
    {% set content_below = '' %}
    {% if '===' in page.rawMarkdown %}
      {% set summary_text = page.summary %}
      {% if page.content starts with summary_text %}
        {% set content_above = summary_text %}
        {% set content_below = page.content|slice(summary_text|length)|trim %}
      {% endif %}
    {% endif %}

    {{ content_above|raw }}

    {# One row above the section cards for finding your place in this guide, full width and stacked on phones:
       - Keep My Place (on unless turned off): for a reader who has visited a section or subsection page before, a
         "Continue reading" bar links to that page, as in Helios Open Reader. js/reader.js fills it in from the
         reader's browser and shows it; its close button forgets the saved place.
       - A search box for this guide on the right (Show Search Box setting, on unless turned off; hidden in embedded
         mode). #}
    {# On a course's Modules page, Keep My Place too (the module pages save the place; a course can turn it off with
       keep_my_place: false on its own page, as in Open Matter); its search box comes with the course's sidebar #}
    {% set course_keeps_place = not modules_mode or not course_page or course_page.header.keep_my_place is not defined or course_page.header.keep_my_place %}
    {% set show_reader_resume = course_keeps_place and (page.header.keep_my_place is not defined or page.header.keep_my_place) %}
    {% set show_reader_search = not modules_mode and (page.header.show_search_box is not defined or page.header.show_search_box)
      and (config.plugins.simplesearch.enabled or config.plugins.tntsearch.enabled) and not embedded_mode %}

    {% if show_reader_resume or show_reader_search %}
      <div class="section-list-actions">
        {% if show_reader_resume %}
          <div class="reader-resume" data-reader-home="{{ page.url }}" hidden>
            <i class="fa fa-bookmark-o" aria-hidden="true"></i>
            <a class="reader-resume-link" href="#">{{ 'THEME_QUARK_OPEN_PUBLISHING.READER_RESUME'|t }}: <span class="reader-resume-title"></span></a>
            <button type="button" class="reader-resume-dismiss" aria-label="{{ 'THEME_QUARK_OPEN_PUBLISHING.READER_RESUME_DISMISS'|t|e('html_attr') }}"><span aria-hidden="true">&times;</span></button>
          </div>
        {% endif %}
        {% if show_reader_search %}
          <div class="reader-search">
            {% include 'partials/search_box.html.twig' with { search_scope: reader_home } %}
          </div>
        {% endif %}
      </div>
    {% endif %}

    {# A card for each section, 1, 2 or 3 per row (one per row on phones) #}
    {# (without the setting: 1 per row on a guide's home page, and 2 on a Modules page, as in Open Matter) #}
    {% set cards_per_row = page.header.cards_per_row|default(modules_mode ? 2 : 1) %}
    {% if cards_per_row == 3 %}
      {% set card_column = 'col-4 col-md-6 col-sm-12' %}
    {% elseif cards_per_row == 2 %}
      {% set card_column = 'col-6 col-sm-12' %}
    {% else %}
      {% set card_column = 'col-12' %}
    {% endif %}

    {# Card Image Layout ("side" or "top", as in Grav Helios Open Reader). Without it: side with 1 card per row,
       so full-width cards aren't too tall, otherwise top. 3 per row is always top. #}
    {% if page.header.card_image_layout %}
      {% set card_image_layout = page.header.card_image_layout %}
    {% elseif cards_per_row == 1 %}
      {% set card_image_layout = 'side' %}
    {% else %}
      {% set card_image_layout = 'top' %}
    {% endif %}
    {% if cards_per_row == 3 %}
      {% set card_image_layout = 'top' %}
    {% endif %}

    {# Description Line Limit, as in Open Reader: card descriptions are cut to 2 or 3 lines, or not at all (0, the default) #}
    {# (on a Modules page, 2 lines without the setting, as in Open Matter) #}
    {% set card_description_lines = page.header.card_description_lines ?? (modules_mode ? 2 : 0) %}
    {% set section_cards_class = 'section-cards columns' %}
    {% if card_description_lines == 2 or card_description_lines == 3 %}
      {% set section_cards_class = section_cards_class ~ ' section-cards-lines-' ~ card_description_lines %}
    {% endif %}

    {# Parts: sections in a row with the same part (their Part setting, or part-N-section-M folders as in Open Reader)
       are grouped under a heading with its title. Sections without a part have no heading.
       The numbers keep counting across parts (Unit 1, 2, 3, ...). #}
    {% set part_groups = [] %}
    {% set group_title = '' %}
    {% set group_sections = [] %}
    {% for section_item in reader_sections %}
      {# (trim turns the macro's result into plain text, so it can be compared with the previous title) #}
      {# (on a Modules page, the modules' Group setting instead, as in Open Matter and Helios Course Hub) #}
      {% set part_title = modules_mode ? (section_item.header.group ?: '') : reader.part_title(section_item, reader_home)|trim %}
      {# a new group starts when the Part changes #}
      {% if not loop.first and part_title != group_title %}
        {% set part_groups = part_groups|merge([{ title: group_title, sections: group_sections }]) %}
        {% set group_sections = [] %}
      {% endif %}
      {% set group_title = part_title %}
      {% set group_sections = group_sections|merge([section_item]) %}
      {% if loop.last %}
        {% set part_groups = part_groups|merge([{ title: group_title, sections: group_sections }]) %}
      {% endif %}
    {% endfor %}

    {# the card's number, counting across all parts and skipping unnumbered sections (numbered: false) #}
    {% set card_number = 0 %}

    {% for part_group in part_groups %}
      {% if part_group.title %}
        <h2 class="reader-part-heading">{{ part_group.title }}</h2>
      {% endif %}
      <ul class="{{ section_cards_class }}">
        {% for section_item in part_group.sections %}
          {% if section_item.header.numbered is not same as(false) %}
            {% set card_number = card_number + 1 %}
          {% endif %}
          {# the label (for example "Unit 2") uses the card's position; don't loop over reader_sections again inside this loop #}
          {% set label = modules_mode ? '' : reader.section_label(section_item, reader_home, card_number) %}
          {# the card's text: the page's Description, or on a Modules page the start of its content, as in Open Matter #}
          {% set card_description = section_item.header.description ?: (modules_mode ? section_item.summary|striptags|trim : '') %}
          {% set card_image = section_item.header.image ? section_item.media[section_item.header.image] : null %}
          {# a card with just a label and title (no image, description or author) gets equal space above and below
             its title (see css/reader.css), instead of the space a description below would normally take #}
          {% set card_class = 'card section-card' %}
          {% if card_image and card_image_layout == 'side' %}
            {% set card_class = card_class ~ ' section-card-image-side' %}
          {% endif %}
          {% if not card_image and not card_description and not section_item.header.author %}
            {% set card_class = card_class ~ ' section-card-title-only' %}
          {% endif %}
          <li class="column {{ card_column }}">
            <div class="{{ card_class }}">
              {% if card_image %}
                <div class="card-image">
                  <img class="img-responsive" src="{{ card_image.cropZoom(800, 400).url }}" alt="">
                </div>
              {% endif %}
              <div class="card-header">
                {# A status badge such as "New" or "Draft" (Badge Label and Badge Color settings, as in Grav Helios Open Reader),
                   on the same line as the section label. Cards without a badge just show the label. #}
                {% set badge_label = section_item.header.badge_label %}
                {% set badge_color = section_item.header.badge_color %}
                {% if badge_color not in ['blue', 'green', 'yellow', 'red', 'purple', 'plain'] %}
                  {% set badge_color = 'default' %}
                {% endif %}
                {% if badge_label %}
                  <div class="section-card-label-row">
                    {% if label|length > 0 %}
                      <p class="reader-section-label">{{ label }}</p>
                    {% endif %}
                    <span class="label label-rounded section-badge section-badge-{{ badge_color }}">{{ badge_label|e }}</span>
                  </div>
                {% elseif label|length > 0 %}
                  <p class="reader-section-label">{{ label }}</p>
                {% endif %}
                {# the link covers the whole card (see css/reader.css). Heading levels: the page title is h1, part headings h2,
                   and card titles h2, or h3 below a part's heading (the h5 class keeps their size the same) #}
                {% set card_heading = part_group.title ? 'h3' : 'h2' %}
                <{{ card_heading }} class="card-title h5"><a class="section-card-link" href="{{ section_item.url ~ filter_suffix }}">{{ section_item.title }}</a>
                  {#- an arrow on every section card, as in Grav Helios Open Reader: these open parts of the guide, unlike blog post cards -#}
                  <i class="fa fa-arrow-right section-card-arrow" aria-hidden="true"></i>
                </{{ card_heading }}>
              </div>
              {% if card_description or section_item.header.author %}
                <div class="card-body">
                  {% if card_description %}
                    <p class="section-card-description">{{ card_description }}</p>
                  {% endif %}
                  {# the section's Author(s) setting, as in Grav Helios Open Reader #}
                  {% if section_item.header.author %}
                    <p class="section-card-author">{{ section_item.header.author }}</p>
                  {% endif %}
                </div>
              {% endif %}
            </div>
          </li>
        {% endfor %}
      </ul>
    {% endfor %}

    {# Start Reading again after the cards, as in Grav Helios Open Reader (only when the Start button shows) #}
    {% if start_url %}
      <p class="section-list-start-below">
        <a href="{{ start_url }}">{{ start_text }} <i class="fa fa-arrow-right" aria-hidden="true"></i></a>
      </p>
    {% endif %}

    {% if content_below %}
      <div class="section-list-below">
        {{ content_below|raw }}
      </div>
    {% endif %}

    {# the page links first, then the guide's attribution, as in Grav Helios Open Reader #}
    {% include 'partials/page_extras.html.twig' with { inline: true } %}
    {% include 'partials/reader_attribution.html.twig' %}

  </div>
  {% endset %}

  {# a course's Modules page shows the course's sidebar beside the cards when the course has one, as in Open Matter #}
  {% set show_sidebar = modules_mode and (page.header.show_sidebar ?? course_has_sidebar) and show_site_chrome %}
  {% if show_sidebar %}
    {% embed 'partials/layout.html.twig' with { show_sidebar: true } %}
      {% block item %}{{ section_list_html|raw }}{% endblock %}
      {% block sidebar %}{% include 'partials/sidebar.html.twig' %}{% endblock %}
    {% endembed %}
  {% else %}
    {{ section_list_html|raw }}
  {% endif %}

{% endblock %}
